{
  "manifest_version": 3,
  "name": "N쇼핑순위검색",
  "description": "미션 등록 화면에서 고른 키워드를 네이버 메인에서 검색해, 쇼핑 PC 검색 5페이지 안에 우리 상품이 있는지 확인합니다.",
  "version": "0.2.0",
  "key": "",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://search.shopping.naver.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.naver.com/*"
      ],
      "js": [
        "src/rank-core.js",
        "src/common.js",
        "src/naver-main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://search.naver.com/*"
      ],
      "js": [
        "src/rank-core.js",
        "src/common.js",
        "src/naver-search.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://search.shopping.naver.com/search/*"
      ],
      "js": [
        "src/rank-core.js",
        "src/common.js",
        "src/naver-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "installed.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
